# ============================================================
# 项目基础
# ============================================================
PROJECT_BASE=../../
DATA_DIR=./data/
PROJECT_NAME=gsapi
BUILD_PROFILE=dev

# ============================================================
# PostgreSQL
# ============================================================
PGSQL_PORT=11070
PGSQL_USER=genshin_map
PGSQL_PASS=
PGSQL_DB=genshin_map
PGSQL_SCHEMA=genshin_map

# ============================================================
# Redis
# ============================================================
REDIS_PORT=11071

# ============================================================
# Nacos
# ============================================================
NACOS_PORT_HTTP=8848
NACOS_PORT_GRPC_CLIENT=9848
NACOS_PORT_GRPC_SERVER=9849
NACOS_USER=nacos
NACOS_PASS=

# ============================================================
# MinIO
# ============================================================
MINIO_PORT_API=11090
MINIO_PORT_CONSOLE=11091
MINIO_PORT_PROXY=11092
# > 用 [[fullPath]] 作为路径占位符。
MINIO_URL_TEMPLATE=http://localhost:11092/[[fullPath]]
# > 将直接访问 API 的请求重定向到控制台的 URL。
# > 默认值：http://localhost:${MINIO_PORT_CONSOLE}
MINIO_REDIRECT_URL=http://localhost:11091
# > 注意：
# > - MinIO 密码需超过 8 个字符
# > - Root 密码用于登录控制台
# > - 非 Root 密码用于外部 API 访问
MINIO_ROOT_USER=admin
MINIO_ROOT_PASS=
MINIO_BUCKET_IMAGE=images
# > Access key 长度需在 3 到 20 之间。
MINIO_KEY=
MINIO_SECRET=

# ============================================================
# MinIO 图片转 WebP
# ============================================================
MINIO_IMG2WEBP_TZ=Asia/Shanghai
MINIO_IMG2WEBP_QUALITY=80
# > MINIO_IMG2WEBP_MODE 可选值：
# > - 0：上传 .webp 到 MinIO
# > - 1：用 webp 内容替换原图
# > - 2：上传 .webp 到 MinIO 并删除原图
MINIO_IMG2WEBP_MODE=0

# ============================================================
# AList
# ============================================================
ALIST_PUID=0
ALIST_PGID=0
ALIST_UMASK=022
ALIST_PORT=11095
ALIST_ROOT_PASSWORD=
ALIST_USERNAME=upload
ALIST_PASSWORD=
ALIST_MOUNT_PATH=/upload_imgs
# > 缓存过期时间，单位：分钟。
ALIST_CACHE_EXPIRE=30

# ============================================================
# OAuth2 JWT 密钥库
# ============================================================
# > 密钥库文件放在 ${DATA_DIR}/api/secrets/oauth2.jks，容器内只读挂载到 /data/secrets
# > 口令必须自行生成并妥善保存，切勿使用示例值；密钥库已不再随仓库与制品分发
# > 首次部署/轮换：见 docs/oauth2-jwt-key-rotation.md
OAUTH2_JKS_LOCATION=file:/data/secrets/oauth2.jks
OAUTH2_JKS_PASSWORD=

# ============================================================
# API / Gateway
# ============================================================
API_PORT=11081
GATEWAY_PORT=11080
