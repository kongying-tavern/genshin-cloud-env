!include_files ./string.ds

fn get_help_commands
    commands_text = readfile ./assets/commands.json
    config = json_parse --collection ${commands_text}
    lines = array

    for cmd in ${config}
        task_name = map_get ${cmd} task
        desc = map_get ${cmd} desc

        task_len = length ${task_name}
        gap_len = calc 30 - ${task_len}
        gap = str_repeat " " ${gap_len}

        line = map
        map_put ${line} color blue
        map_put ${line} prefix "  - "
        map_put ${line} task ${task_name}
        map_put ${line} gap ${gap}
        map_put ${line} desc ${desc}
        array_push ${lines} ${line}

        children = map_get ${cmd} children
        for child in ${children}
            child_task = map_get ${child} task
            child_desc = map_get ${child} desc

            child_task_len = length ${child_task}
            child_gap_len = calc 28 - ${child_task_len}
            child_gap = str_repeat " " ${child_gap_len}

            child_line = map
            map_put ${child_line} color green
            map_put ${child_line} prefix "    - "
            map_put ${child_line} task ${child_task}
            map_put ${child_line} gap ${child_gap}
            map_put ${child_line} desc ${child_desc}
            array_push ${lines} ${child_line}
        end
    end

    # Printable rows own their values; the parsed config can be released here.
    release --recursive ${config}
    return ${lines}
end

fn print_help_commands
    lines = set ${1}

    for line in ${lines}
        color = map_get ${line} color
        prefix = map_get ${line} prefix
        task_name = map_get ${line} task
        gap = map_get ${line} gap
        desc = map_get ${line} desc

        print ${prefix}
        print -c ${color} ${task_name}
        print ${gap}
        print " "
        print ${desc}
        echo
    end
end
